library ieee;
use ieee.std_logic_1164.all;

entity fsm_tb is
end entity;

architecture sim of fsm_tb is

  component fsm
    generic (TEMPORIZADOR : integer);
    port (
      clk        : in std_logic;
      reset      : in std_logic;
      semaforo_d : out std_logic;
      semaforo_e : out std_logic;
      semaforo_b : out std_logic;
      semaforo_c : out std_logic
    );
  end component;

  signal clk                                            : std_logic := '0';
  signal reset                                          : std_logic := '0';
  signal semaforo_d, semaforo_e, semaforo_b, semaforo_c : std_logic;

  constant CLK_PERIOD : time := 10 ns;

begin
  uut : fsm
  generic map(TEMPORIZADOR => 10)
  port map
  (
    clk        => clk,
    reset      => reset,
    semaforo_d => semaforo_d,
    semaforo_e => semaforo_e,
    semaforo_b => semaforo_b,
    semaforo_c => semaforo_c
  );

  process
  begin
    clk <= '0';
    wait for CLK_PERIOD / 2;
    clk <= '1';
    wait for CLK_PERIOD / 2;
  end process;

  process
  begin
    reset <= '1';
    wait for 3 * CLK_PERIOD;
    reset <= '0';

    wait for 25 * CLK_PERIOD;

    reset <= '1';
    wait for 3 * CLK_PERIOD;
    reset <= '0';

    wait for 25 * CLK_PERIOD;

    assert false
    report "acabou"
      severity failure;

    wait;
  end process;
end architecture;